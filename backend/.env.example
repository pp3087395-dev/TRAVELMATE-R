# ==============================================================================
# TravelMate Backend Environment Variables (Render Web Service)
# ==============================================================================

# Server Environment (Render automatically injects PORT, but 5000 is used locally)
PORT=5000
NODE_ENV=production

# Supabase PostgreSQL Connection
# Obtain from: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# TIP for Render: Use the Session Pooler (port 5432) or Transaction Pooler (port 6543)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Supabase API Credentials
# Obtain from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# AI Microservice URL
# Point to your deployed Render AI Microservice Web Service
# e.g., https://travelmate-ai-service.onrender.com (use http://localhost:8000 locally)
AI_SERVICE_URL=https://travelmate-ai-service.onrender.com

# Allowed CORS Origins
# Comma-separated list of allowed frontend origins, or * for open access.
# Note: Vercel domains (*.vercel.app) and localhost are automatically accepted.
CORS_ORIGIN=https://travelmate-frontend.vercel.app

# Google Maps Platform (Optional for backend directions/distance matrix)
GOOGLE_MAPS_API_KEY=AIzaSy...

# Google Gemini AI (Official @google/genai fallback & TM Chatbot)
GEMINI_API_KEY=
GEMINI_MODELS=

# Digital India Bhashini Language API (Optional)
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_INFERENCE_API_KEY=
BHASHINI_PIPELINE_ID=
BHASHINI_PIPELINE_ENDPOINT=

# ==============================================================================
# Production OTP Verification Gateways (Email & SMS)
# ==============================================================================

# Email Gateway (Nodemailer / SMTP)
# Supports Gmail (App Password), SendGrid, AWS SES, Brevo, Outlook, etc.
# If omitted, Nodemailer auto-provisions Ethereal test accounts with live web previews.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_FROM="TravelMate SafeVisit" <no-reply@travelmate.gov.in>

# SMS Gateway (Fast2SMS - India +91)
# Used for instant Indian OTP SMS routes: https://www.fast2sms.com
FAST2SMS_API_KEY=

# SMS Gateway (Twilio - Global)
# Used for worldwide international tourist numbers: https://www.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

